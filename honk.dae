# config.dae
# Load all honk files placed in ./config.d/.
include {
    config.d/*.dae
}

global {
    log_level: warn
    check_interval: 600s
    check_tolerance: 30ms
    lan_interface: br-lan
    wan_interface: auto
    auto_config_kernel_parameter: true
    disable_waiting_network: false
    data_dir: '/etc/honk'
    log_file: '/var/log/honk/honk.log'
    store_subscribe: true
    # if u not using dns bind, set dial_mode to domain++ prefer
    dial_mode: domain
    bootstrap_resolver: '223.5.5.5:53'
    tcp_check_url: 'https://www.gstatic.com/generate_204'
    tcp_check_http_method: HEAD
    udp_check_dns: 'dns.google.com:53', '8.8.8.8', '2001:4860:4860::8888'
}

assets {
    geodata {
        geosite: 'https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/release/geosite.dat'
        geoip: 'https://raw.githubusercontent.com/QiuSimons/geoip-moedove/refs/heads/main/geoip.dat'
    }
}

# node.dae
subscription {
    sub: {
        url: '订阅链接'
        ua: 'honk/1.0 like'
        route: direct
    }
    # 需要独立刷新周期时使用块形式；interval: 0 可禁用定期刷新
    # sub2: {
    #     url: 'http://sub'
    #     ua: 'honk/1.0'
    #     interval: '10000s'
    # }
}

#node {
#    home-socks5: 'socks5://user:pass@gw.example.com:1080'
#    ss-node: 'ss://YWVzLTEyOC1nY206cGFzc3dvcmQ=@ss.example.com:8388'
#    trojan-ws: 'trojan://secret@trojan.example.com:443?sni=trojan.example.com&type=ws&path=%2Fws&host=trojan.example.com'
#    hy2-node: 'hysteria2://secret@hy2.example.com:443?sni=hy2.example.com'
#}

# policy 可选 select（面板手动选，默认）/ min_moving_avg（延迟最低）/ fallback（按顺序取第一个存活）/ loadbalance（轮询）/ score（按实际连接质量评分）；final：所选节点不可用时改走的组
group {
    proxy {
        policy: min_moving_avg
        final: Final
        interrupt_connections: true
    }
    AI {
        filter: name(regex: '🇺🇸美|美国|US|us|United States')
        interrupt_connections: true
    }
    YouTube {
        filter: !name(regex: '.*')
        filter: !name(regex: '🇸🇬|新|新加坡|SG|sg|Singapore')
        final: Final
        interrupt_connections: true
    }
    Google {
        filter: !name(regex: '.*')
        filter: name(regex: '🇯🇵|日|日本|JP|jp|Japan', regex: '🇺🇸|美|美国|US|us|United States')
        final: Final
        interrupt_connections: true
    }
    Github {
        policy: min_moving_avg
        final: Final
        interrupt_connections: true
    }
    Telegram {
        filter: !name(regex: '.*')
        filter: name(regex: '🇰🇷|韩|韩国|韓|KR|kr|Korea', regex: '🇯🇵|日|日本|JP|jp|Japan')
        final: Final
        interrupt_connections: true
    }
    TikTok {
        filter: !name(regex: '.*')
        filter: name(regex: '🇰🇷|韩|韩国|韓|KR|kr|Korea', regex: '🇯🇵|日|日本|JP|jp|Japan', regex: '🇺🇸|美|美国|US|us|United States')
        final: Final
        interrupt_connections: true
    }
    Netflix {
        filter: !name(regex: '.*')
        filter: name(regex: '🇺🇸|美|美国|US|us|United States')
        final: Final
        interrupt_connections: true
    }
    Wallet {
        filter: !name(regex: '.*')
        filter: name(regex: '🇺🇸|美|美国|US|us|United States')
        final: Final
        interrupt_connections: true
    }
    Steam {
        filter: !name(regex: '.*')
        filter: name(regex: '🇭🇰|港|香港|HK|hk|Hong Kong', regex: '🇯🇵|日|日本|JP|jp|Japan', regex: '🇰🇷|韩|韩国|韓|KR|kr|Korea')
        final: Final
        interrupt_connections: true
    }
    Microsoft {
        filter: !name(regex: '.*')
        filter: name(regex: '🇯🇵|日|日本|JP|jp|Japan', regex: '🇰🇷|韩|韩国|韓|KR|kr|Korea')
        final: Final
        interrupt_connections: true
    }
    OneDrive {
        filter: !name(regex: '.*')
        filter: name(regex: '🇯🇵|日|日本|JP|jp|Japan', regex: '🇰🇷|韩|韩国|韓|KR|kr|Korea')
        final: Final
        interrupt_connections: true
    }
    Apple {
        filter: !name(regex: '.*')
        filter: name(regex: '🇭🇰|港|香港|HK|hk|Hong Kong', regex: '🇯🇵|日|日本|JP|jp|Japan', regex: '🇰🇷|韩|韩国|韓|KR|kr|Korea')
        final: Final
        interrupt_connections: true
    }
    Final {
        filter: !name(regex: '官网|剩余|流量|套餐|免费|订阅|到期时间|直连|Expire Date|Traffic|ExpireDate')
        policy: score
    }
}

# dns.dae
dns {
    upstream {
        remote: 'https://8.8.8.8/dns-query'
        local: 'https://223.5.5.5/dns-query'
    }
    routing {
        request {
            qtype(https, svcb) -> reject
            qtype(aaaa) -> reject
            qname(suffix: googleapis.cn, suffix: xn--ngstr-lra8j.com) -> remote
            qname(geosite: cn, geosite: microsoft@cn, geosite: apple@cn, geosite: private) -> local
            qname(geosite: geolocation-!cn) -> remote
            fallback: remote
        }
        response {
            # remote 解析出国内 IP 时改用 local 重查，拿到就近 CDN
            upstream(remote) && ip(geoip: cn) -> local
            fallback: accept
        }
    }
}

# route.dae
routing {
    dip(geoip: private, geoip: cn) && !dport(53, 853) -> direct(must)
    dport(853) -> block
    l4proto(udp) && dport(443) -> block
    domain(suffix: googleapis.cn, suffix: xn--ngstr-lra8j.com) -> Google
    domain(suffix: withgoogle.com, suffix: notebooklm.google, geosite: category-ai-!cn) -> AI
    domain(geosite: youtube) -> YouTube
    domain(geosite: google) -> Google
    domain(geosite: github) -> Github
    domain(geosite: onedrive) -> OneDrive
    domain(geosite: microsoft@cn) -> direct
    domain(geosite: microsoft) -> Microsoft
    domain(geosite: apple@cn) -> direct
    domain(geosite: apple) -> Apple
    domain(geosite: telegram) -> Telegram
    domain(geosite: tiktok) -> TikTok
    domain(geosite: netflix) -> Netflix
    domain(geosite: paypal, geosite: binance, geosite: okx, geosite: category-cryptocurrency) -> Wallet
    domain(geosite: steam@cn) -> direct
    domain(geosite: steam) -> Steam
    domain(geosite: geolocation-!cn) -> proxy
    dip(geoip: telegram) -> Telegram
    fallback: Final
}

# api.dae
# Configure API access for HONK dashboards and controllers.
experimental {
    native_api {
        enabled: true
        listen: '0.0.0.0:9527'
        secret: '<redacted>'
        ui: '/etc/honk/doona'
        config_write: true
    }
}
